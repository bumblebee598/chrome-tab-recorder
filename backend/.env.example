# --- GCP ---
GOOGLE_CLOUD_PROJECT=your-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-project-id-tab-recorder-audio
TASKS_LOCATION=us-central1

# --- Local emulators (unset these in production) ---
FIRESTORE_EMULATOR_HOST=localhost:8080
CLOUD_TASKS_EMULATOR_HOST=localhost:8123

# --- OAuth (one client in one GCP project; redirect https://<ext-id>.chromiumapp.org/) ---
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me

# --- Secrets (Secret Manager in prod) ---
ASSEMBLYAI_API_KEY=change-me
SESSION_JWT_SECRET=change-me
WEBHOOK_SECRET=change-me
TOKEN_FERNET_KEY=change-me  # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Service URLs ---
API_BASE_URL=http://localhost:8000
WORKER_BASE_URL=http://localhost:8081

# --- Email ---
EMAIL_PROVIDER=gmail  # gmail | resend
RESEND_API_KEY=
