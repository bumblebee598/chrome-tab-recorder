# Copy to backend/.env (gitignored). In production these live in Secret
# Manager / Cloud Run env vars — this file is for local development.

# --- GCP ---
GOOGLE_CLOUD_PROJECT=demo-tab-recorder     # any string works against the emulators
GCP_REGION=us-central1
GCS_BUCKET=your-project-id-tab-recorder-audio
TASKS_LOCATION=us-central1

# --- Local emulators (never set in production) ---
FIRESTORE_EMULATOR_HOST=localhost:8080
CLOUD_TASKS_EMULATOR_HOST=localhost:8123

# --- Google OAuth client (console -> Credentials; secret is backend-only) ---
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me

ASSEMBLYAI_API_KEY=change-me

# --- `make gen-secrets` and paste ---
SESSION_JWT_SECRET=change-me               # signs backend-issued session tokens
WEBHOOK_SECRET=change-me                   # authenticates AssemblyAI webhook callbacks
TOKEN_FERNET_KEY=change-me                 # encrypts stored refresh tokens

# --- Service URLs ---
API_BASE_URL=http://localhost:8000         # public api (webhook target)
WORKER_BASE_URL=http://localhost:8081      # private worker (Cloud Tasks target)

# --- Email ---
EMAIL_PROVIDER=gmail                       # gmail | resend
RESEND_API_KEY=
