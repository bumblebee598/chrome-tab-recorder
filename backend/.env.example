# Copy to backend/.env (gitignored). In production these live in Secret
# Manager / Cloud Run env vars — this file is for local development.

# --- GCP project ---
# Any string works against the local emulators; use the real project ID for deploys.
GOOGLE_CLOUD_PROJECT=demo-tab-recorder
GCP_REGION=us-central1
GCS_BUCKET=your-project-id-tab-recorder-audio
TASKS_LOCATION=us-central1

# --- Local emulators ---
# Point the backend at `make dev`'s emulators. NEVER set in production —
# their presence is what switches the backend off the real services.
FIRESTORE_EMULATOR_HOST=localhost:8080
CLOUD_TASKS_EMULATOR_HOST=localhost:8123

# --- Google OAuth client (console.cloud.google.com -> Credentials) ---
# The ID identifies the app during sign-in; the secret proves the
# code-for-token exchange comes from our backend. Secret never ships client-side.
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=change-me

# --- Third-party ---
# Authenticates transcription submissions (AssemblyAI dashboard -> API key).
ASSEMBLYAI_API_KEY=change-me

# --- Generated secrets: run `make gen-secrets` and paste the output ---
# SESSION_JWT_SECRET  signs the login sessions the backend issues to the extension
# WEBHOOK_SECRET      lets the public webhook endpoint verify calls are from AssemblyAI
# TOKEN_FERNET_KEY    encrypts stored Google refresh tokens at rest in Firestore
SESSION_JWT_SECRET=change-me
WEBHOOK_SECRET=change-me
TOKEN_FERNET_KEY=change-me

# --- Service URLs ---
# API_BASE_URL is what AssemblyAI's webhook calls back to (the public api);
# WORKER_BASE_URL is where Cloud Tasks delivers stage tasks (the private worker).
API_BASE_URL=http://localhost:8000
WORKER_BASE_URL=http://localhost:8081

# --- Email ---
# gmail sends as the signed-in user via their OAuth grant (no setup);
# resend is the fallback provider and needs its own key.
EMAIL_PROVIDER=gmail
RESEND_API_KEY=
